# Public (safe for the browser). From Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Absolute site URL used for auth email redirects (e.g. https://alums.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# No service-role key is required: all authorization runs in Postgres (RLS + SECURITY DEFINER RPCs).
